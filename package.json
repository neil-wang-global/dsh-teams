{
  "name": "dsh-teams",
  "version": "0.0.0",
  "private": true,
  "description": "Use DeepSeek Harness (DSH) with your team.",
  "license": "MPL-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install --force",
    "test": "npm run test --workspaces --if-present",
    "test:probe": "npm test --workspace @dsh-teams/probe",
    "lint:plan": "node --check packages/dsh-teams-probe/src/manifest.mjs && node --check packages/dsh-teams-probe/src/report.mjs",
    "check": "npm run lint:plan && npm run test:probe"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-wang-global/dsh-teams.git"
  },
  "bugs": {
    "url": "https://github.com/neil-wang-global/dsh-teams/issues"
  },
  "homepage": "https://github.com/neil-wang-global/dsh-teams#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "lefthook": "^2.1.10"
  }
}
